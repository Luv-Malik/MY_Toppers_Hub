    // Safe Fetch with Fallback
    async function loadSubjectsFromApi() {
      try {
        const response = await fetch('./notes.json');
        if (!response.ok) throw new Error('File not found');
        subjectsConfig = await response.json();
      } catch (error) {
        console.warn('JSON file load nahi hui, fallback data ka use kar rahe hain.');
        subjectsConfig = fallbackSubjectsConfig;
      }
